# Базовый URL PocketBase без завершающего слэша (пусто — только site.default.json)
VITE_POCKETBASE_URL=

# Только для npm run pocketbase:setup. Не попадают в бандл сайта.
# POCKETBASE_ADMIN_EMAIL=
# POCKETBASE_ADMIN_PASSWORD=

# Прямая ссылка на Telegram (например https://t.me/username)
VITE_TELEGRAM_URL=
# Или только username без @ (если VITE_TELEGRAM_URL пуст)
VITE_TELEGRAM_USERNAME=

# Опционально: URL для POST заявки (Formspree, n8n и т.п.)
# Если пусто — отправка откроет Telegram с текстом заявки
VITE_LEAD_FORM_ENDPOINT=
